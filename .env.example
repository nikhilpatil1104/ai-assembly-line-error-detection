# Demo segmentation works ONLY for artificial color-coded panel examples. Not AI.
ASSEMBLY_DETECTOR=demo_color
# After training custom YOLO weights, change ASSEMBLY_DETECTOR=yolo
ASSEMBLY_WEIGHTS=weights/best.pt
ASSEMBLY_CONFIDENCE=0.55
ASSEMBLY_LOW_CONFIDENCE=0.25
# Warn only when strictly greater than 10% of images are flagged
ASSEMBLY_BATCH_WARNING=0.10
ASSEMBLY_MAX_IMAGE_MB=12
# ASSEMBLY_RUNTIME_DIR=.runtime
